{
  "appId": "pt.ronron.app",
  "appName": "Ronron",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#F7F1E8"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#F7F1E8",
      "showSpinner": false
    },
    "LocalNotifications": {
      "iconColor": "#E3954A"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
